{
  "name": "pam-desktop",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "server:dev": "node server/pam-sync-server.mjs",
    "server:start": "node server/pam-sync-server.mjs",
    "db:migrate": "node server/run-migrations.mjs",
    "test:server": "node server/pam-sync-server.test.mjs",
    "test:server:postgres": "node server/pam-postgres-store.integration.test.mjs",
    "test:server:object-storage": "node server/pam-object-storage.integration.test.mjs",
    "test:e2e": "vite build && playwright test",
    "test:e2e:headed": "vite build && playwright test --headed",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@tauri-apps/api": "^1.5.0",
    "@types/uuid": "^10.0.0",
    "date-fns": "^4.1.0",
    "jspdf": "^3.0.3",
    "jspdf-autotable": "^5.0.2",
    "pg": "^8.23.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.2",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@playwright/test": "1.55.0",
    "@tauri-apps/cli": "^1.5.9",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@typescript-eslint/eslint-plugin": "^8.44.1",
    "@typescript-eslint/parser": "^8.44.1",
    "eslint": "^9.36.0",
    "eslint-plugin-json": "^4.0.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.4.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.1",
    "vite": "^7.1.6"
  }
}
