VITE_ENV=production
VITE_DEBUG=false
VITE_APP_NAME=PAM

# Local secure storage
VITE_SECURE_LOCAL_STORAGE=true

# European cloud sync target.
# Allowed production provider values in the frontend adapter:
# - ovhcloud-eu
# - scaleway-eu
# - custom-eu
VITE_CLOUD_SYNC_ENABLED=false
VITE_CLOUD_PROVIDER=ovhcloud-eu
VITE_CLOUD_REGION_POLICY=eu-only

# Backend base URL or explicit sync endpoint.
# Keep secrets out of Vite env files. The browser uses HttpOnly session cookies.
VITE_API_URL=https://api.example.eu
VITE_CLOUD_SYNC_ENDPOINT=https://api.example.eu/api/pam/sync/push
