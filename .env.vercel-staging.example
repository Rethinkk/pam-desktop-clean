VITE_ENV=production
VITE_DEBUG=false
VITE_APP_NAME=PAM
VITE_SECURE_LOCAL_STORAGE=true

VITE_PAM_DATA_RESIDENCY=eu
VITE_CLOUD_SYNC_ENABLED=true
VITE_CLOUD_PROVIDER=scaleway-eu
VITE_CLOUD_REGION_POLICY=eu-only

# Replace with the Scaleway backend URL after the container is deployed.
VITE_AUTH_API_URL=https://pam-europe-staging-api.example
VITE_API_URL=https://pam-europe-staging-api.example
VITE_CLOUD_SYNC_ENDPOINT=https://pam-europe-staging-api.example/api/pam/sync/push

