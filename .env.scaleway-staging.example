# PAM Europe staging database.
# Copy this file to `.env.scaleway-staging` and replace the password locally.
# Never commit `.env.scaleway-staging`.

# Prefer separate fields so passwords with special characters do not need URL encoding.
PAM_DATABASE_HOST=rw-dec9a101-5bfe-484a-917b-f2a175331000.rdb.nl-ams.scw.cloud
PAM_DATABASE_PORT=1135
PAM_DATABASE_NAME=pam_staging
PAM_DATABASE_USER=pam_app
PAM_DATABASE_PASSWORD=VUL_HIER_WACHTWOORD_IN
PAM_DATABASE_SSL=true
PAM_DATABASE_CA_FILE=/path/to/rdb-pam-europe-staging-db.pem
# Use PAM_DATABASE_CA_CERT instead when the CA certificate is stored as a cloud secret.
PAM_DATABASE_CA_CERT=
# Or use PAM_DATABASE_CA_CERT_BASE64 when the cloud UI cannot store multiline PEM safely.
PAM_DATABASE_CA_CERT_BASE64=
PAM_DATABASE_TLS_SERVERNAME=rw-dec9a101-5bfe-484a-917b-f2a175331000.rdb.nl-ams.scw.cloud
PAM_DATABASE_INTEGRATION_TEST=true

# Used only when starting the local sync server against Scaleway staging.
PAM_SESSION_SECRET=replace-with-a-local-32-plus-character-secret
PAM_ALLOW_DEV_LOGIN=false
PAM_ALLOWED_ORIGIN=http://127.0.0.1:5174

# PAM Europe staging Object Storage.
PAM_OBJECT_STORAGE_BUCKET=pam-europe-staging-documents
PAM_OBJECT_STORAGE_REGION=nl-ams
PAM_OBJECT_STORAGE_ENDPOINT=https://s3.nl-ams.scw.cloud
PAM_OBJECT_STORAGE_ACCESS_KEY=VUL_ACCESS_KEY_ID_IN
PAM_OBJECT_STORAGE_SECRET_KEY=VUL_SECRET_KEY_IN
PAM_OBJECT_STORAGE_INTEGRATION_TEST=true
